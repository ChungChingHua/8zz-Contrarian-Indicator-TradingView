if barstate.isfirst
    if not timeframe.isminutes or timeframe.multiplier != 30
        runtime.error("請切換標準30分鐘K線，勿用日線或其他週期。")
    if startAt >= finishAt
        runtime.error("開始日期必須早於截止日期，且本資料最多至2026/9/30。")
    if useHtfConfirm and timeframe.in_seconds(htfTf) <= timeframe.in_seconds()
        runtime.error("高週期確認必須大於30分鐘。")


// Session orders alone cannot remove overnight mark-to-market/drawdown from the broker emulator.
if barstate.isconfirmed and inWindow and not dayBar
    runtime.error("本策略只計日盤：請先在圖表設定選擇常規／日盤交易時段，避免夜盤影響回測損益與回撤。")

// Native broker-emulator execution: one net position; same-bar events coalesce.
var int eventCursor = 0
var int signalDir = 0
var int dayBarCount = 0
var int entryDayBarA = na
var int skippedBeforeChart = 0
var int eligibleEvents = 0
var bool cutoffReached = false

// Never backfill old signals at the first available chart bar.
if barstate.isfirst
    while eventCursor < array.size(evt_time)
        if array.get(evt_time, eventCursor) >= time
            break
        skippedBeforeChart += 1
        eventCursor += 1

bool flipNow = false
bool submittedLong = false
bool submittedShort = false
string lastTip = ""

if barstate.isconfirmed and dayBar
    dayBarCount += 1
    if strategy.position_size == 0
        entryDayBarA := na

    if inWindow
        int beforeDir = signalDir
        while eventCursor < array.size(evt_time)
            int eventTime = array.get(evt_time, eventCursor)
            // Strictly after event time, identical for A and B.
            if eventTime >= time_close
                break
            int d = array.get(evt_dir, eventCursor)
            if eventTime >= startAt and eventTime < publicationBefore and d != 0
                bool trendOk = d == 1 ? close > emaBasis and emaBasis >= emaBasis[1] : close < emaBasis and emaBasis <= emaBasis[1]
                bool rsiOk = d == 1 ? rsiValue >= 50 : rsiValue <= 50
                bool htfOk = d == 1 ? htfClose >= htfEma : htfClose <= htfEma
                bool passFilters = (not useTrendFilter or trendOk) and (not useRsiFilter or rsiOk) and (not useVolFilter or atrPct >= minAtrPct) and (not useHtfConfirm or htfOk)
                if passFilters
                    signalDir := d
                    eligibleEvents += 1
                    lastTip := array.get(evt_tips, eventCursor)
            eventCursor += 1
        flipNow := signalDir != beforeDir and signalDir != 0

        // Terminal liquidation is separate from A/B rules; never use October/November fills.
        if time_close == finishAt
            strategy.cancel_all()
            strategy.close_all(comment="回測截止日盤收盤", immediately=true)
            cutoffReached := true
        else
            bool fixedExitNow = modeA and strategy.position_size != 0 and not na(entryDayBarA) and dayBarCount - entryDayBarA >= holdBars
            if fixedExitNow
                strategy.close_all(comment="A：固定K棒出場", immediately=true)
                entryDayBarA := na

            if flipNow and orderQty > 0
                if modeA
                    // Do not open at the same close as the old A position exits.
                    if strategy.position_size == 0 and not fixedExitNow
                        if signalDir == 1
                            strategy.entry("L", strategy.long, qty=orderQty, comment="A：偏多翻轉")
                            entryDayBarA := dayBarCount
                            submittedLong := true
                        else if allowShort
                            strategy.entry("S", strategy.short, qty=orderQty, comment="A：偏空翻轉")
                            entryDayBarA := dayBarCount
                            submittedShort := true
                else
                    // Opposite strategy.entry reverses the existing net position at the same close.
                    if signalDir == 1
                        strategy.entry("L", strategy.long, qty=orderQty, comment="B：偏多翻轉")
                        submittedLong := true
                    else if allowShort
                        strategy.entry("S", strategy.short, qty=orderQty, comment="B：偏空翻轉")
                        submittedShort := true
                    else
                        strategy.close("L", comment="B：偏空訊號平多", immediately=true)

if barstate.isconfirmed and time_close > finishAt
    strategy.cancel_all()

plotshape(showSignals and flipNow and signalDir == 1, title="偏多翻轉訊號（非成交）", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="訊號")
plotshape(showSignals and flipNow and signalDir == -1, title="偏空翻轉訊號（非成交）", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="訊號")
if showSignals and flipNow and str.length(lastTip) > 0
    label.new(bar_index, signalDir == 1 ? low : high, "", style=label.style_none, tooltip=lastTip, textcolor=color.gray)
bgcolor(dayBar and inWindow ? (signalDir == 1 ? color.new(color.green, 95) : signalDir == -1 ? color.new(color.red, 95) : na) : na)

if showPanel and barstate.islast
    var table info = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 10), border_width=1)
    int judged = strategy.closedtrades
    float nativeWinRate = judged > 0 ? strategy.wintrades * 100.0 / judged : na
    table.cell(info, 0, 0, "8zz 原生策略回測", text_color=color.white)
    table.cell(info, 1, 0, modeA ? "A：固定" + str.tostring(holdBars) + "棒" : "B：等反轉", text_color=color.aqua)
    table.cell(info, 0, 1, "交易時段", text_color=color.gray)
    table.cell(info, 1, 1, futuresProfile ? "台指日盤08:45–13:45" : "台股09:00–13:30", text_color=color.white)
    table.cell(info, 0, 2, "原生已平倉／勝率", text_color=color.gray)
    table.cell(info, 1, 2, str.tostring(judged) + " / " + (na(nativeWinRate) ? "—" : str.tostring(nativeWinRate, "#.##") + "%"), text_color=color.white)
    table.cell(info, 0, 3, "目前持倉", text_color=color.gray)
    table.cell(info, 1, 3, str.tostring(strategy.position_size), text_color=color.white)
    table.cell(info, 0, 4, "已處理保存事件", text_color=color.gray)
    table.cell(info, 1, 4, str.tostring(eligibleEvents) + " / " + str.tostring(array.size(evt_time)), text_color=color.white)
    table.cell(info, 0, 5, "圖表開始前略過事件", text_color=color.gray)
    table.cell(info, 1, 5, str.tostring(skippedBeforeChart) + "（需載入完整歷史）", text_color=skippedBeforeChart > 0 ? color.yellow : color.white)
    table.cell(info, 0, 6, "回測截止", text_color=color.gray)
    table.cell(info, 1, 6, str.format_time(finishAt, "yyyy-MM-dd HH:mm", tz), text_color=color.white)
    table.cell(info, 0, 7, "截止日收盤棒", text_color=color.gray)
    table.cell(info, 1, 7, cutoffReached ? "已處理／截止平倉" : "尚未載入或資料缺漏", text_color=cutoffReached ? color.white : color.yellow)
    table.cell(info, 0, 8, "成本／實際成交", text_color=color.gray)
    table.cell(info, 1, 8, "屬性設定佣金與滑價；看策略訂單箭頭", text_color=color.yellow)
