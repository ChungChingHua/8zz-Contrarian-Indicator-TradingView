// Research backtest only: historical post-time signals, not a live AI feed or broker connection.
//@version=6
strategy("8zz 延續版－策略回測 A/B（ATR與移動停損v4）", overlay=true, max_labels_count=500,
     pyramiding=0, initial_capital=20000000, currency=currency.TWD,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=0, slippage=0,
     margin_long=100, margin_short=100, process_orders_on_close=true,
     calc_on_every_tick=false, calc_on_order_fills=false)

grpExec = "策略執行"
exitMode = input.string("B｜反向訊號出場", "出場模式", options=["A｜固定K棒出場", "B｜反向訊號出場"], group=grpExec)
holdBars = input.int(17, "A：固定持有日盤K棒數", minval=1, maxval=50, group=grpExec)
marketProfile = input.string("自動依圖表", "圖表市場／部位方式", options=["自動依圖表", "台指期貨日盤", "0050 ETF"], group=grpExec)
contractQty = input.int(1, "期貨固定口數", minval=1, maxval=100, group=grpExec)
etfCapitalPct = input.float(100.0, "ETF名目本金比例 (%)", minval=1, maxval=100, group=grpExec)
allowShort = input.bool(true, "允許偏空訊號放空（未核對借券限制）", group=grpExec)
showSignals = input.bool(true, "顯示翻轉訊號（成交看策略箭頭）", group=grpExec)
showPanel = input.bool(true, "顯示原生策略統計提示", group=grpExec)

grpRisk = "風險出場（可獨立開關）"
useAtrStop = input.bool(true, "啟用ATR固定停損", group=grpRisk)
useTrailingStop = input.bool(true, "啟用獲利後移動停損", group=grpRisk)
riskAtrLen = input.int(14, "停損ATR長度", minval=2, maxval=100, group=grpRisk)
atrStopMult = input.float(2.0, "固定停損：進場ATR倍數", minval=0.1, step=0.1, group=grpRisk)
trailActivationMult = input.float(1.0, "移動停損：獲利達進場ATR倍數後啟動", minval=0.1, step=0.1, group=grpRisk)
trailDistanceMult = input.float(1.5, "移動停損：距有利極值的進場ATR倍數", minval=0.1, step=0.1, group=grpRisk,
     tooltip="使用進場時已完成棒的ATR，持倉期間固定。收盤確認極值後更新停損，不回溯套用於該棒；只開此項時，啟動前沒有價格停損。")
showRiskStop = input.bool(true, "顯示目前有效停損線", group=grpRisk)

grpDates = "歷史測試範圍（只取日期，台北時間）"
startDate = input.time(timestamp("01 Dec 2025 00:00 +0800"), "開始日期", group=grpDates)
endDate = input.time(timestamp("30 Sep 2026 00:00 +0800"), "截止日期（日盤收盤強制平倉）", group=grpDates,
     tooltip="本檔最多測試到2026/9/30；截止日收盤強制平倉會計入TradingView已結算交易。")

grpFilters = "原有濾網（預設全部關閉）"
useTrendFilter = input.bool(false, "EMA趨勢濾網", group=grpFilters)
emaLen = input.int(55, "EMA長度", minval=5, maxval=300, group=grpFilters)
useRsiFilter = input.bool(false, "RSI動能濾網", group=grpFilters)
rsiLen = input.int(14, "RSI長度", minval=2, maxval=100, group=grpFilters)
useVolFilter = input.bool(false, "ATR波動濾網", group=grpFilters)
atrLen = input.int(14, "ATR長度", minval=2, maxval=100, group=grpFilters)
minAtrPct = input.float(1.0, "最低ATR波動率 (%)", minval=0.1, maxval=20, group=grpFilters)
useHtfConfirm = input.bool(false, "已完成高週期結構確認", group=grpFilters)
htfTf = input.timeframe("240", "確認週期", group=grpFilters)

string tz = "Asia/Taipei"
bool modeA = exitMode == "A｜固定K棒出場"
bool chartIsFutures = syminfo.type == "futures"
bool futuresProfile = marketProfile == "自動依圖表" ? chartIsFutures : marketProfile == "台指期貨日盤"
int sessionStartHour = futuresProfile ? 8 : 9
int sessionStartMinute = futuresProfile ? 45 : 0
int sessionEndMinute = futuresProfile ? 45 : 30
int startAt = timestamp(tz, year(startDate, tz), month(startDate, tz), dayofmonth(startDate, tz), 0, 0)
int requestedEnd = timestamp(tz, year(endDate, tz), month(endDate, tz), dayofmonth(endDate, tz), 13, sessionEndMinute)
int hardEnd = timestamp(tz, 2026, 9, 30, 13, sessionEndMinute)
int finishAt = math.min(requestedEnd, hardEnd)
int publicationBefore = timestamp("01 Oct 2026 00:00 +0800")
// Compare the actual chart bar boundaries, not virtual bars rebased to a custom session.
int dayStart = timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), sessionStartHour, sessionStartMinute)
int dayEnd = timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), 13, sessionEndMinute)
int localWeekday = dayofweek(time, tz)
bool weekday = localWeekday >= dayofweek.monday and localWeekday <= dayofweek.friday
// Some RTH feeds label the closing auction minute through 13:46 (TXF) / 13:31 (ETF).
// This accepts only that final +1-minute marker, never a bar starting after dayEnd.
bool closingMinuteMarker = time >= dayStart and time < dayEnd and time_close == dayEnd + 60 * 1000 and time_close - time <= 31 * 60 * 1000
bool dayBar = weekday and time >= dayStart and time < dayEnd and (time_close <= dayEnd or closingMinuteMarker)
// Logical signal cutoff remains the exchange day close. Native fill timestamps remain unchanged.
int decisionClose = closingMinuteMarker ? dayEnd : time_close
bool inWindow = decisionClose >= startAt and decisionClose <= finishAt

float emaBasis = ta.ema(close, emaLen)
float rsiValue = ta.rsi(close, rsiLen)
float atrPct = ta.atr(atrLen) / close * 100
// Previous completed HTF bar only; the offset prevents historical lookahead.
float htfClose = request.security(syminfo.tickerid, htfTf, close[1], lookahead=barmerge.lookahead_on)
float htfEma = request.security(syminfo.tickerid, htfTf, ta.ema(close, emaLen)[1], lookahead=barmerge.lookahead_on)
float riskAtr = ta.atr(riskAtrLen)
float orderQty = futuresProfile ? float(contractQty) : math.floor(strategy.equity * etfCapitalPct / 100 / (close * syminfo.pointvalue))

